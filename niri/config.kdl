// Config adapted for Parrot OS / Denegen

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
    }

    mouse {
        natural-scroll
    }

    touchpad {
        tap
        natural-scroll
    }
    
    focus-follows-mouse max-scroll-amount="10%"
}

// AUTOSTART
spawn-sh-at-startup "$HOME/.config/niri/autostart.sh"

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

layout {
    gaps 15

    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#c06a86"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        top 24
        bottom 24
        left 8
    }
}

blur {
    passes 2
    offset 4
    noise 0.02
    saturation 0.9
}


hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 2.5
}

layer-rule {
    match namespace="swaybg"
    place-within-backdrop true
}

window-rule {
    geometry-corner-radius 7
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.8
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match is-focused=false
    opacity 0.7
}

window-rule {
    match app-id=r#"firefox$"#
    open-maximized true
    opacity 0.9
}

window-rule {
    match app-id="swayimg"
    match app-id="Ferdium"
    match app-id="org.qbittorrent.qBittorrent"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

layer-rule {
    match namespace="fuzzel"
    opacity 0.9
    geometry-corner-radius 7
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="waybar"
    background-effect {
        blur true
        xray false
    }
}

binds {
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+F { spawn "firefox"; }
    Mod+T { spawn "nemo"; }
    Mod+E { spawn "ferdium"; }
    Mod+X { spawn "ymuse"; }

    Mod+Ctrl+L { spawn "swaylock"; }
    Mod+N { spawn-sh "swaync-client -t -sw"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    Mod+Ctrl+Space { spawn-sh "mpc toggle"; }
    Mod+Ctrl+M     { spawn-sh "mpc next"; }
    Mod+Ctrl+N     { spawn-sh "mpc prev"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+Shift+WheelScrollDown      cooldown-ms=50 { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    Mod+Shift+WheelScrollUp        cooldown-ms=50 { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+"; }

    Mod+Ctrl+Shift+WheelScrollDown { focus-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { focus-column-left; }

    Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Shift+F { maximize-column; }
    Mod+Ctrl+F { fullscreen-window; }

    Mod+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Asterisk { set-column-width "+10%"; }

    Mod+Shift+Space { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }

    Mod+W { spawn "$HOME/.config/niri/bin/wallpaper-select.sh"; }

    Mod+M { spawn "$HOME/.config/niri/bin/volume-menu.sh"; }

    Mod+Shift+C { spawn "$HOME/.config/niri/bin/calendar-popup.sh"; }

    Mod+P { spawn "$HOME/.config/niri/bin/powermenu.sh"; }

    Mod+V { spawn "$HOME/.config/niri/bin/clipmenu.sh"; }

    Mod+Shift+N { spawn "$HOME/.config/niri/bin/wifi-menu.sh"; }

    Mod+Equal { spawn "$HOME/.config/niri/bin/calc-menu.sh"; }

    Mod+Alt+M { spawn "$HOME/.config/niri/bin/media-menu.sh"; }

    Mod+Alt+Q { spawn "$HOME/.config/niri/bin/qr-tool.sh"; }

    Mod+Alt+S { spawn "$HOME/.config/niri/bin/niri-session.py"; }

    Mod+Alt+R { spawn "$HOME/.config/niri/bin/niri-session.py" "restore"; }

    Mod+B { spawn "$HOME/.config/niri/bin/battery-menu.sh"; }
}
